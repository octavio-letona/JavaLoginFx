<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane id="mainPane" prefHeight="650.0" prefWidth="1000.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="org.octavioletona.controller.CajeroDashboardController">
    <stylesheets>
        <URL value="@/org/octavioletona/view/style/cajerodashboardview.css" />
    </stylesheets>
    
    <left>
        <VBox id="sidebar" spacing="15.0" prefWidth="260.0">
            <Label id="logoLabel" text="Terminal Cajero" />
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Button text="Punto de Venta" styleClass="menuBtn, activeMenuBtn" maxWidth="Infinity" />
                <Button text="Corte de Caja" styleClass="menuBtn" maxWidth="Infinity" />
                <Button text="Historial de Facturas" styleClass="menuBtn" maxWidth="Infinity" />
                <Button text="Consultar Precios" styleClass="menuBtn" maxWidth="Infinity" />
            </VBox>
            <Button text="Cerrar Sesión" styleClass="logoutBtn" maxWidth="Infinity" />
        </VBox>
    </left>
    
    <center>
        <VBox id="contentArea" spacing="25.0">
            <HBox id="headerBar" alignment="CENTER_RIGHT">
                <Label fx:id="lblBienvenida" text="Bienvenido, Cajero" id="welcomeLabel" />
            </HBox>
            
            <VBox id="dashboardCards" spacing="20.0" VBox.vgrow="ALWAYS">
                <Label text="Resumen de Turno" styleClass="sectionTitle" />
                <HBox spacing="20.0">
                    <VBox styleClass="statCard" HBox.hgrow="ALWAYS">
                        <Label text="Transacciones Hoy" styleClass="statTitle" />
                        <Label text="28" styleClass="statValue" />
                    </VBox>
                    <VBox styleClass="statCard" HBox.hgrow="ALWAYS">
                        <Label text="Efectivo en Caja" styleClass="statTitle" />
                        <Label text="Q. 1,450.00" styleClass="statValue" />
                    </VBox>
                    <VBox styleClass="statCard" HBox.hgrow="ALWAYS">
                        <Label text="Devoluciones" styleClass="statTitle" />
                        <Label text="1" styleClass="statValue" />
                    </VBox>
                </HBox>
                
                <Label text="Estado de Caja y Notificaciones" styleClass="sectionTitle" />
                <VBox styleClass="activityPanel" VBox.vgrow="ALWAYS">
                    <Label text="Caja aperturada correctamente a las 08:00 AM. Impresora térmica conectada y lista para facturar." styleClass="activityText" />
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
