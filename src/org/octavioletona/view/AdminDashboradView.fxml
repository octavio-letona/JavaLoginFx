<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane id="mainPane" prefHeight="650.0" prefWidth="1000.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="org.octavioletona.controller.AdminDashboradController">
    <stylesheets>
        <URL value="@/org/octavioletona/view/style/admindashboradview.css" />
    </stylesheets>
    
    <left>
        <VBox id="sidebar" spacing="15.0" prefWidth="260.0">
            <Label id="logoLabel" text="Sistema Admin" />
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" styleClass="menuBtn, activeMenuBtn" maxWidth="Infinity" />
                <Button text="Usuarios" styleClass="menuBtn" maxWidth="Infinity" />
                <Button text="Reportes" styleClass="menuBtn" maxWidth="Infinity" />
                <Button text="Configuración" styleClass="menuBtn" maxWidth="Infinity" />
            </VBox>
            <Button text="Cerrar Sesión" styleClass="logoutBtn" maxWidth="Infinity" />
        </VBox>
    </left>
    
    <center>
        <VBox id="contentArea" spacing="25.0">
            <HBox id="headerBar" alignment="CENTER_RIGHT">
                <Label fx:id="lblBienvenida" text="Bienvenido" id="welcomeLabel" />
            </HBox>
            
            <VBox id="dashboardCards" spacing="20.0" VBox.vgrow="ALWAYS">
                <Label text="Resumen General" styleClass="sectionTitle" />
                <HBox spacing="20.0">
                    <VBox styleClass="statCard" HBox.hgrow="ALWAYS">
                        <Label text="Usuarios Activos" styleClass="statTitle" />
                        <Label text="1,204" styleClass="statValue" />
                    </VBox>
                    <VBox styleClass="statCard" HBox.hgrow="ALWAYS">
                        <Label text="Nuevos Registros" styleClass="statTitle" />
                        <Label text="+84" styleClass="statValue" />
                    </VBox>
                    <VBox styleClass="statCard" HBox.hgrow="ALWAYS">
                        <Label text="Sesiones Hoy" styleClass="statTitle" />
                        <Label text="342" styleClass="statValue" />
                    </VBox>
                </HBox>
                
                <Label text="Actividad Reciente" styleClass="sectionTitle" />
                <VBox styleClass="activityPanel" VBox.vgrow="ALWAYS">
                    <Label text="El sistema se encuentra operando de manera óptima y no hay alertas de seguridad pendientes." styleClass="activityText" />
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
